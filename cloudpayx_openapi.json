{
  "openapi": "3.0.3",
  "info": {
    "title": "cloudpayX Agent Services API",
    "description": "Paid XRPL machine-intelligence services protected by x402 v2 payments on XRPL mainnet.",
    "version": "3.0",
    "contact": {
      "url": "https://api.cloudpayxagent.xyz"
    },
    "x-guidance": "Discover paid resources via GET /.well-known/x402. Paid POST endpoints return HTTP 402 with x402 v2 XRPL payment requirements before releasing intelligence. cloudpayX exposes transaction repair, risk assessment, ledger status, arbitrage analysis, classic token analysis, stablecoin routing, and universal V3 analysis for XRP, issued currencies, MPT issuances, and NFTokens."
  },
  "servers": [
    {
      "url": "https://api.cloudpayxagent.xyz",
      "description": "cloudpayX Agent production API"
    }
  ],
  "paths": {
    "/agent/arbitrage-check": {
      "post": {
        "summary": "XRPL Arbitrage Check V2",
        "description": "Simulates an XRPL round-trip cycle using validated order-book liquidity, evaluates both execution legs, calculates final amount and gross return, and determines whether a positive executable arbitrage edge exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "amount"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "example": "RLUSD"
                  },
                  "to": {
                    "type": "string",
                    "example": "USDC"
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "example": 1000
                  }
                }
              },
              "example": {
                "from": "RLUSD",
                "to": "USDC",
                "amount": 1000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Arbitrage Check V2 response including forward and reverse execution legs, round-trip economics, opportunity state, and decision signal."
          },
          "402": {
            "description": "x402 v2 payment required"
          }
        },
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "amount": "0.01",
            "currency": "USD"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
