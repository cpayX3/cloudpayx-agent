          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              },
              "example": {}
            }
          }
        }
      }
    },
    "/.well-known/x402": {
      "get": {
        "summary": "x402 discovery catalog",
        "description": "Machine-readable discovery metadata for cloudpayX paid resources.",
        "responses": {
          "200": {
            "description": "x402 resource catalog"
          }
        },
        "security": []
      }
