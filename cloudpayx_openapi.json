                  "amount"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "example": "RLUSD"
                  },
                  "to": {
                    "type": "string",
                    "example": "USDC"
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "example": 1000
                  }
                }
              },
              "example": {
                "from": "RLUSD",
                "to": "USDC",
                "amount": 1000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risk Check V2 response including composite risk score, risk dimensions, issuer analysis, liquidity, execution simulation, network state, decision signal, flags, and rule thresholds."
          },
          "402": {
            "description": "x402 v2 payment required"
          }
        },
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "amount": "0.02",
            "currency": "USD"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/agent/repair": {
      "post": {
        "summary": "XRPL Transaction Repair V2",
        "description": "Classifies XRPL engine results and returns deterministic diagnosis, probable causes, retry safety, rebuild/resign requirements, and machine-readable recovery actions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "engine_result"
                ],
                "properties": {
                  "engine_result": {
                    "type": "string",
                    "example": "tecUNFUNDED_PAYMENT"
                  },
                  "transaction_type": {
                    "type": "string",
                    "example": "Payment"
                  },
                  "engine_result_message": {
                    "type": "string",
                    "example": "Insufficient XRP balance to send."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repair V2 diagnosis including result classification, severity, probable causes, recommended recovery steps, retry safety, rebuild/resign requirements, decision signal, and confidence."
          },
          "402": {
            "description": "x402 v2 payment required"
          }
        },
        "security": [],
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "amount": "0.10",
            "currency": "USD"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        }
      }
    },
    "/agent/ledger-status": {
